# Copie ce fichier en .env puis remplis-le.

# App TikTok (developers.tiktok.com -> ton app -> Client key / Client secret)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Redirect URI « Desktop » enregistrée dans Login Kit (doit être identique)
TIKTOK_REDIRECT_URI=http://localhost:8082/callback

# draft  = brouillon dans l'app TikTok (tu publies d'un clic)
# direct = publication automatique (publique seulement après l'audit TikTok de ton app)
TIKTOK_MODE=draft
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# Heure(s) de publication, plusieurs possibles : 12:30,19:00
POST_TIMES=18:00
TZ=Europe/Paris
VIDEOS_PER_RUN=1

# Types de vidéos tirés au hasard (vide = tous) :
# EscapeRings, InfiniteCube, InfiniteSpiral, EscapeBox, RingCountdown, Katana, ClockSweep, GearArcs,
# PinArt, PotatoMerge, MarbleMelody, GrowingBall, Multiply, Polyrhythm, PendulumWave, Galton, Sorting
SCENES=EscapeRings,InfiniteCube,InfiniteSpiral,EscapeBox,RingCountdown,Katana,ClockSweep,GearArcs,PinArt,PotatoMerge,MarbleMelody

# Jours de conservation des vidéos déjà envoyées
KEEP_DAYS=7

# 1 = publie une vidéo dès le démarrage du conteneur (pour tester)
RUN_ON_START=0

# Domaine qui pointe vers le VPS, pour le mini-site demandé par TikTok (docker compose --profile site up -d)
DOMAIN=
# Token DuckDNS (en haut de la page duckdns.org) : nécessaire pour le site sur le port 8082
DUCKDNS_TOKEN=

# Voix des patates (Piper) : fr_FR-siwis-medium (femme) ou fr_FR-tom-medium (homme)
PIPER_VOICE=fr_FR-siwis-medium
